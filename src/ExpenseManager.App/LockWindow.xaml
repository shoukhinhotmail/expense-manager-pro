<Window
    x:Class="ExpenseManager.App.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="280">
            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AppAccentBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="26" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="Expense Manager Pro is locked" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Enter your PIN to continue" Opacity="0.6" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <PasswordBox x:Name="PinBox" PlaceholderText="PIN" MaxLength="6"
                         PasswordRevealMode="Peek" KeyDown="PinBox_KeyDown" />

            <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />

            <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Click="UnlockButton_Click" />

            <Button x:Name="HelloButton" Content="Use Windows Hello" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="HelloButton_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
