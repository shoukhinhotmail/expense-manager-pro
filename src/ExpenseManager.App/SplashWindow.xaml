<Window
    x:Class="ExpenseManager.App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <Border Width="84" Height="84" CornerRadius="20" Background="{StaticResource AppAccentBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="$" FontSize="44" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>

            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="Expense Manager Pro" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Track every taka, dollar, and euro." Opacity="0.6" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressRing IsActive="True" Width="24" Height="24" Margin="0,16,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
