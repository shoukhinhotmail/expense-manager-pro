<Application
    x:Class="ExpenseManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ExpenseManager.App.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== Brand color tokens ===================== -->
            <!-- Overrides the Windows system accent so the app has a consistent
                 brand identity regardless of the user's OS accent color. -->
            <Color x:Key="SystemAccentColor">#6366F1</Color>
            <Color x:Key="SystemAccentColorLight1">#7B7EF4</Color>
            <Color x:Key="SystemAccentColorLight2">#9698F6</Color>
            <Color x:Key="SystemAccentColorLight3">#B4B5F9</Color>
            <Color x:Key="SystemAccentColorDark1">#5052D9</Color>
            <Color x:Key="SystemAccentColorDark2">#4143BC</Color>
            <Color x:Key="SystemAccentColorDark3">#33359E</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#EEF0FE" />

            <Color x:Key="AppIncomeColor">#16A34A</Color>
            <Color x:Key="AppExpenseColor">#DC2626</Color>
            <SolidColorBrush x:Key="AppIncomeBrush" Color="{StaticResource AppIncomeColor}" />
            <SolidColorBrush x:Key="AppExpenseBrush" Color="{StaticResource AppExpenseColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#D97706" />

            <!-- ===================== Layout tokens ===================== -->
            <x:Double x:Key="AppPageMaxWidth">1120</x:Double>
            <CornerRadius x:Key="AppCardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="AppChipCornerRadius">10</CornerRadius>
            <Thickness x:Key="AppCardPadding">20</Thickness>

            <!-- ===================== Reusable styles ===================== -->
            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
            </Style>

            <Style x:Key="AppPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AppSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="AppMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="AppIconChipStyle" TargetType="Border">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="{StaticResource AppChipCornerRadius}" />
            </Style>

            <!-- ===================== Converters ===================== -->
            <conv:CurrencyConverter x:Key="CurrencyConverter" />
            <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
            <conv:HexToTintBrushConverter x:Key="HexToTintBrushConverter" />
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:TransactionTypeToBrushConverter x:Key="TransactionTypeToBrushConverter" />
            <conv:WalletTypeToGlyphConverter x:Key="WalletTypeToGlyphConverter" />
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
            <conv:NullableDateToTextConverter x:Key="NullableDateToTextConverter" />
            <conv:InvertBoolConverter x:Key="InvertBoolConverter" />

            <!-- ===================== Shared templates ===================== -->
            <!-- Expects DataContext = a Category (Glyph, Color). -->
            <DataTemplate x:Key="CategoryAvatarTemplate">
                <Border Width="40" Height="40" CornerRadius="{StaticResource AppChipCornerRadius}"
                        Background="{Binding Color, Converter={StaticResource HexToTintBrushConverter}}">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                              Foreground="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
