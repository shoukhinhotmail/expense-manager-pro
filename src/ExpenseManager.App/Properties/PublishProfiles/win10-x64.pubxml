<Project>
  <!--
    Produces a packaged (MSIX) build for Microsoft Store submission, without touching the
    unpackaged dev setup in the main .csproj (WindowsPackageType=None there stays the default
    for `dotnet build`/`dotnet run`; this profile only applies during `dotnet publish` /
    Visual Studio's "Create App Packages" wizard).

    Note: Visual Studio's own "Create App Packages" wizard generates/overwrites its own version
    of this file once you associate the app with your reserved Store name — that's expected;
    this hand-written version exists so the packaging pipeline (manifest, images, build) can be
    verified from the command line before you ever open that wizard.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
