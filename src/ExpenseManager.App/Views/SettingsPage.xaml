<Page
    x:Class="ExpenseManager.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ExpenseManager.App.Controls">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="28" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="Personalize the app and manage your data" Style="{StaticResource AppMutedTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="App theme" Description="Choose light, dark, or match your Windows setting">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeCombo" MinWidth="160" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </ctcontrols:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Currency" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="Display currency" Description="All amounts in the app are shown in this currency">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8C3;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <controls:CurrencyPickerControl x:Name="CurrencyPicker" Width="260"
                                                     CurrencySelected="CurrencyPicker_CurrencySelected" />
                </ctcontrols:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Security" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="PIN lock" Description="Require a PIN to open the app">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="PinLockToggle" Toggled="PinLockToggle_Toggled" />
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="WindowsHelloCard" Header="Windows Hello"
                                          Description="Unlock with your face, fingerprint, or device PIN instead of typing"
                                          Visibility="Collapsed">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEE57;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="WindowsHelloToggle" Toggled="WindowsHelloToggle_Toggled" />
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="ChangePinCard" Header="Change PIN" Visibility="Collapsed"
                                          IsClickEnabled="True" Click="ChangePinCard_Click">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                </ctcontrols:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Backup &amp; restore" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="Back up your data" Description="Save a copy of your database to a file you choose">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <Button Content="Back up now" Click="BackupButton_Click" />
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard Header="Restore from backup" Description="Replace current data with a backup file. The app will restart.">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7A6;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <Button Content="Restore..." Click="RestoreButton_Click" />
                </ctcontrols:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Cloud backup" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="Google Drive" Description="Back up and restore your data using your Google account">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE753;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="GoogleDriveStatusText" Text="Not connected" Opacity="0.7" VerticalAlignment="Center" />
                        <Button x:Name="GoogleDriveConnectButton" Content="Connect" Click="GoogleDriveConnect_Click" />
                    </StackPanel>
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="GoogleDriveAutoBackupCard" Header="Auto backup"
                                          Description="Back up automatically once a day while the app is open"
                                          Visibility="Collapsed">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="GoogleDriveAutoBackupToggle" Toggled="GoogleDriveAutoBackupToggle_Toggled" />
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="GoogleDriveBackupNowCard" Header="Back up to Google Drive now"
                                          Visibility="Collapsed" IsClickEnabled="True" Click="GoogleDriveBackupNow_Click">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74E;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="GoogleDriveRestoreCard" Header="Restore from Google Drive"
                                          Visibility="Collapsed" IsClickEnabled="True" Click="GoogleDriveRestore_Click">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7A6;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                </ctcontrols:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="About" Style="{StaticResource AppSectionHeaderStyle}" />
                <ctcontrols:SettingsCard Header="Expense Manager Pro" Description="Version 0.1 (MVP)">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                </ctcontrols:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
