<Page
    x:Class="ExpenseManager.App.Views.AiInsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="AI Insights" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="Personalized spending insights and budget suggestions, generated entirely on your device" Style="{StaticResource AppMutedTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}"
                    Visibility="{x:Bind ViewModel.IsModelDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Runs fully offline, on your device" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource AppMutedTextStyle}" TextWrapping="Wrap">
                        This feature uses a small AI model that runs entirely on your computer — nothing about your spending is ever sent anywhere.
                        It's a one-time download (about 1.7 GB); after that, it works forever with no internet connection and no subscription.
                    </TextBlock>

                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                            Click="DownloadButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Download AI model" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" Maximum="1" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Downloading — this may take a few minutes depending on your connection."
                                       Style="{StaticResource AppMutedTextStyle}" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Cancel" Click="CancelDownloadButton_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardStyle}"
                    Visibility="{x:Bind ViewModel.IsModelDownloaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Generate insights" FontWeight="SemiBold" />
                            <TextBlock Text="Looks at this month's spending, budgets, and savings goals" Style="{StaticResource AppMutedTextStyle}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="GenerateButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}" Width="14" Height="14"
                                              Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE945;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                <TextBlock Text="Generate insights" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource AppExpenseBrush}"
                               TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}, Mode=OneWay}" />

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource AppChipCornerRadius}"
                            Padding="16" Visibility="{x:Bind ViewModel.InsightsText, Converter={StaticResource StringNotEmptyToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.InsightsText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Border>

                    <HyperlinkButton Content="Remove AI model (frees ~1.7 GB)" Click="DeleteModelButton_Click" HorizontalAlignment="Left" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
