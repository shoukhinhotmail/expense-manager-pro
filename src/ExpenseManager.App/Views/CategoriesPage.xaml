<Page
    x:Class="ExpenseManager.App.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:ExpenseManager.Core.Entities">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24">
            <StackPanel Spacing="2">
                <TextBlock Text="Categories" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="Organize your expenses and income into categories" Style="{StaticResource AppMutedTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Expense categories" Style="{StaticResource AppSectionHeaderStyle}" />
                        <Button Grid.Column="1" Content="Add" Click="AddExpenseCategory_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ExpenseCategories, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:Category">
                                <Grid Padding="0,10" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" ContentTemplate="{StaticResource CategoryAvatarTemplate}"
                                                     Content="{x:Bind}" IsTabStop="False" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditCategory_Click" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteCategory_Click" Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Income categories" Style="{StaticResource AppSectionHeaderStyle}" />
                        <Button Grid.Column="1" Content="Add" Click="AddIncomeCategory_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IncomeCategories, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:Category">
                                <Grid Padding="0,10" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" ContentTemplate="{StaticResource CategoryAvatarTemplate}"
                                                     Content="{x:Bind}" IsTabStop="False" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditCategory_Click" Tag="{x:Bind}" />
                                                <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteCategory_Click" Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
