<Page
    x:Class="ExpenseManager.App.Views.IncomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:ExpenseManager.Core.Entities">

    <Grid Padding="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Income" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Style="{StaticResource AppMutedTextStyle}">
                    <Run Text="Total earned:" />
                    <Run Text="{x:Bind ViewModel.Total, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add income" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left"
                            PlaceholderText="Search income" QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                            TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="1" VerticalAlignment="Center" Click="FiltersToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Filters" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" x:Name="FiltersPanel" Margin="0,12,0,0" Style="{StaticResource AppCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="CategoryFilterCombo" Header="Category" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox Grid.Column="1" x:Name="WalletFilterCombo" Header="Wallet" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              ItemsSource="{x:Bind ViewModel.Wallets, Mode=OneWay}"
                              SelectionChanged="Filter_Changed" />
                    <CalendarDatePicker Grid.Column="2" x:Name="FromDatePicker" Header="From date" HorizontalAlignment="Stretch"
                                         PlaceholderText="Any" DateChanged="DateFilter_Changed" />
                    <CalendarDatePicker Grid.Column="3" x:Name="ToDatePicker" Header="To date" HorizontalAlignment="Stretch"
                                         PlaceholderText="Any" DateChanged="DateFilter_Changed" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Grid.Column="0" x:Name="MinAmountBox" Header="Min amount" PlaceholderText="No minimum"
                               SpinButtonPlacementMode="Hidden" ValueChanged="AmountFilter_Changed" />
                    <NumberBox Grid.Column="1" x:Name="MaxAmountBox" Header="Max amount" PlaceholderText="No maximum"
                               SpinButtonPlacementMode="Hidden" ValueChanged="AmountFilter_Changed" />
                    <Button Grid.Column="2" Content="Clear filters" VerticalAlignment="Bottom" Click="ClearFilters_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource AppCardStyle}" Padding="20,8">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}" SelectionMode="None"
                          Visibility="{x:Bind ViewModel.Transactions.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=invert}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:Transaction">
                            <Grid Padding="0,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource CategoryAvatarTemplate}"
                                                 Content="{x:Bind Category}" IsTabStop="False" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Category.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource AppMutedTextStyle}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind Note, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Date}" VerticalAlignment="Center"
                                           Style="{StaticResource AppMutedTextStyle}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppIncomeBrush}" Margin="0,0,4,0" />
                                <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditButton_Click" Tag="{x:Bind}" />
                                            <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteButton_Click" Tag="{x:Bind}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Spacing="10" Padding="0,48" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.Transactions.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="32" Opacity="0.35" HorizontalAlignment="Center" />
                    <TextBlock Text="No income yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Record your first income to see it here." Style="{StaticResource AppMutedTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
