<Page
    x:Class="ExpenseManager.App.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Export" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="Get your transactions out in any format you need" Style="{StaticResource AppMutedTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="What to export" Style="{StaticResource AppSectionHeaderStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="PeriodCombo" Header="Period" HorizontalAlignment="Stretch"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="This month" IsSelected="True" />
                            <ComboBoxItem Content="Last month" />
                            <ComboBoxItem Content="This year" />
                            <ComboBoxItem Content="All time" />
                        </ComboBox>
                        <ComboBox Grid.Column="1" x:Name="TypeCombo" Header="Type" HorizontalAlignment="Stretch"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All transactions" IsSelected="True" />
                            <ComboBoxItem Content="Expenses only" />
                            <ComboBoxItem Content="Income only" />
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="WalletCombo" Header="Wallet" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Name" SelectionChanged="Filter_Changed" />
                    </Grid>

                    <TextBlock x:Name="MatchCountText" Style="{StaticResource AppMutedTextStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Share" Style="{StaticResource AppSectionHeaderStyle}" />
                <TextBlock Text="Post a beautiful summary card to social apps, or share your exported files directly"
                           Style="{StaticResource AppMutedTextStyle}" FontSize="12" />

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Summary card" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Square" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="ShareSquareCard_Click" />
                            <Button Grid.Column="1" Content="Story" HorizontalAlignment="Stretch" Click="ShareStoryCard_Click" />
                            <Button Grid.Column="2" Content="Wide" HorizontalAlignment="Stretch" Click="ShareLandscapeCard_Click" />
                        </Grid>
                        <HyperlinkButton Content="Copy square card to clipboard" Click="CopyCardToClipboard_Click"
                                         Padding="0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Format" Style="{StaticResource AppSectionHeaderStyle}" />

                <ctcontrols:SettingsCard Header="CSV" Description="Plain spreadsheet-friendly text file">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ShareCsv_Click" ToolTipService.ToolTip="Share">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        </Button>
                        <Button Content="Export CSV" Click="ExportCsv_Click" />
                    </StackPanel>
                </ctcontrols:SettingsCard>

                <ctcontrols:SettingsCard Header="Excel" Description="Formatted .xlsx workbook">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ShareExcel_Click" ToolTipService.ToolTip="Share">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        </Button>
                        <Button Content="Export Excel" Click="ExportExcel_Click" />
                    </StackPanel>
                </ctcontrols:SettingsCard>

                <ctcontrols:SettingsCard Header="PDF report" Description="Printable summary with totals and category breakdown">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="SharePdf_Click" ToolTipService.ToolTip="Share">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        </Button>
                        <Button Content="Export PDF" Click="ExportPdf_Click" />
                    </StackPanel>
                </ctcontrols:SettingsCard>

                <ctcontrols:SettingsCard Header="JSON" Description="Raw structured data, useful for developers or other tools">
                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </ctcontrols:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ShareJson_Click" ToolTipService.ToolTip="Share">
                            <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        </Button>
                        <Button Content="Export JSON" Click="ExportJson_Click" />
                    </StackPanel>
                </ctcontrols:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
