<Page
    x:Class="ExpenseManager.App.Views.WalletsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ExpenseManager.App.ViewModels">

    <Grid Padding="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Wallets" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="Track balances across cash, bank, cards, and mobile banking" Style="{StaticResource AppMutedTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add wallet" />
                </StackPanel>
            </Button>
        </Grid>

        <ItemsControl Grid.Row="1" Margin="0,20,0,0" ItemsSource="{x:Bind ViewModel.Wallets, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WalletRow">
                    <Border Style="{StaticResource AppCardStyle}" Width="320" Margin="0,0,16,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource AppChipCornerRadius}"
                                        Background="{Binding Wallet.Color, Converter={StaticResource HexToTintBrushConverter}}">
                                    <FontIcon Glyph="{Binding Wallet.Type, Converter={StaticResource WalletTypeToGlyphConverter}}"
                                              FontSize="16" Foreground="{Binding Wallet.Color, Converter={StaticResource HexToBrushConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Wallet.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditButton_Click" Tag="{Binding Wallet}" />
                                            <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteButton_Click" Tag="{Binding Wallet}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Balance, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
